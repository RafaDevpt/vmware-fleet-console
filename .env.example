# PT-PT: Modelo de variáveis de ambiente. Copie para .env e preencha.
#        O .env nunca entra no repositório (ver .gitignore). A aplicação lê
#        estas variáveis do ambiente; não carrega o ficheiro sozinha.
# EN-UK: Environment variable template. Copy to .env and fill it in.
#        .env never enters the repository (see .gitignore). The application
#        reads these variables from the environment; it does not load the file.
#
# Linux/macOS:  set -a; . ./.env; set +a
# Docker:       docker run --env-file .env ...
#
# Created by Redfox using Claude

# PT-PT: Senha do vCenter/ESXi para execução sem interacção. / EN-UK: vCenter/ESXi password for unattended runs.
VFC_PASSWORD=change-me
